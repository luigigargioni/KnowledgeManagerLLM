# ─────────────────────────────────────────────────────────────────────────────
#  Logging
# ─────────────────────────────────────────────────────────────────────────────
FILE_LOG_LEVEL=DEBUG
TERMINAL_LOG_LEVEL=WARNING
CHECK_NVIDIA_GPU=0

# ─────────────────────────────────────────────────────────────────────────────
#  MAIN backend — the system under test: therapy manager, checker, extractors
# ─────────────────────────────────────────────────────────────────────────────
# PROVIDER: openai | groq | openrouter | ollama. Leave empty to infer it from the
# keys below (OpenAI first, then Groq, then OpenRouter), falling back to the local
# Ollama server. A .env holding several keys therefore needs this set explicitly.
#
# MODEL is the provider's own id, and they do not agree on spelling: the same
# weights are "gpt-oss:20b" on Ollama and "openai/gpt-oss-20b" on OpenRouter. On
# OpenRouter the ":free" suffix names a different listing of the same model, with
# its own price (none) and its own server-side cap (20 requests/minute plus a low
# daily ceiling) — set LLM_RPM/LLM_RPD when using one, since the defaults below
# leave OpenRouter unthrottled.
PROVIDER=ollama
MODEL=gpt-oss:20b
# Sent on every call; supported by the gpt-oss family, rejected by models with
# no reasoning mode (leave empty for those). Values: low | medium | high.
REASONING_EFFORT=low
LLM_TIMEOUT=120

# ── Sampling ────────────────────────────────────────────────────────────────
# Both are OMITTED from the request when left empty, so the provider's own
# default applies — which is what this project did before these knobs existed.
# Write them down when a result has to be reproducible: an unset temperature is
# still a choice, and its value depends on the backend (1.0 on OpenAI, whatever
# the Modelfile says on Ollama — read it with `ollama show <model> --modelfile`).
#
# TEMPERATURE: the gpt-oss model card recommends temperature=1.0 with top_p=1.0
#   (https://github.com/openai/gpt-oss). Lowering it to cut run-to-run variance is
#   a deliberate deviation from the recommended operating point, not a free win —
#   measure the effect on answer quality before adopting it.
#   Careful on OpenAI's *hosted* reasoning models: they reject a non-default
#   temperature whenever REASONING_EFFORT is also set (400 "Unsupported value:
#   'temperature' does not support 0 with this model"). Ollama documents
#   temperature, seed and reasoning_effort as supported together
#   (https://docs.ollama.com/api/openai-compatibility), but that has not been
#   verified here against gpt-oss:20b — see the note on LLMConfig.
#   Note also that the scale is ambiguous across backends: the OpenAI range is
#   0.0-2.0 while some local models use 0.0-1.0 (ollama/ollama#3151).
# SEED: makes draws repeatable while leaving the sampling distribution at the
#   recommended temperature — but ONLY on local single-replica inference.
#   Measured 2026-08-24, one prompt repeated with seed=42:
#     openrouter / openai/gpt-oss-20b  5 distinct outputs out of 5 (default
#       routing served it from four different upstreams); still 3 out of 3 with
#       the upstream pinned. OpenRouter advertises seed as supported anyway.
#     openai / gpt-5.4-mini            3 distinct out of 3, and no
#       system_fingerprint in the response at all.
#   So on these backends a fixed seed does NOT make a run reproducible, and two
#   runs that differ cannot be attributed to a code change. Use N repetitions and
#   report the spread instead — that holds for the judge too, not just for the
#   therapy manager.
TEMPERATURE=
SEED=

# ─────────────────────────────────────────────────────────────────────────────
#  SIM backend — the test harness: simulated caregiver + judge
# ─────────────────────────────────────────────────────────────────────────────
# Fully independent of MAIN: its own provider AND model, so a locally served
# model can be graded by a cloud one, or two Groq models can be used to get two
# separate quotas. Any SIM_* left empty falls back to its MAIN counterpart.
SIM_PROVIDER=
SIM_MODEL=
# Left empty on purpose: the judge grades with the provider's default reasoning
# (medium on gpt-oss). Set it to low to make batches cheaper, at the risk of
# coarser grading. Note that an empty value here does NOT inherit from MAIN.
SIM_REASONING_EFFORT=
# SIM_LLM_TIMEOUT=120

# Same three-way convention as SIM_REASONING_EFFORT: commented out inherits from
# MAIN, present-but-empty means "do not send it", a value overrides MAIN.
# The judge is where reproducibility pays off most — its verdict was measured
# swinging between runs on byte-identical input, so a fixed SIM_SEED makes a
# re-grade comparable. Leave SIM_TEMPERATURE at the model's recommended value.
SIM_TEMPERATURE=
SIM_SEED=

# ─────────────────────────────────────────────────────────────────────────────
#  Credentials and endpoints — per provider, shared by both roles
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# OPENAI_URL=                      # only for an OpenAI-compatible gateway

GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai/v1

# OpenRouter speaks the OpenAI protocol, so only the key and the base URL differ.
# Useful here for serving a gpt-oss model without a local GPU: PROVIDER=openrouter
# with MODEL=openai/gpt-oss-20b is the hosted equivalent of PROVIDER=ollama with
# MODEL=gpt-oss:20b.
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1

OLLAMA_URL=http://localhost:11434

# ─────────────────────────────────────────────────────────────────────────────
#  Client-side rate limiting — enforced per provider:model, before sending
# ─────────────────────────────────────────────────────────────────────────────
# Defaults come from the provider: Groq free tier = 30 RPM / 8K TPM / 1K RPD /
# 200K TPD; OpenAI and Ollama are unthrottled. 0 disables a limit. Raise these
# after upgrading the Groq tier — pacing is what makes a batch slow, not the API.
# LLM_RPM=30
# LLM_TPM=8000
# LLM_RPD=1000
# LLM_TPD=200000

# Same knobs for the simulation backend (prefix SIM_):
# SIM_LLM_RPM=30
# SIM_LLM_TPM=8000
# SIM_LLM_RPD=1000
# SIM_LLM_TPD=200000

# Tokens reserved for the answer when sizing a request against TPM. Only used
# until the estimator has calibrated itself on the first few responses.
LLM_COMPLETION_RESERVE=1200
# Retries on 429/5xx, and the longest Retry-After honoured before giving up
# (a longer wait means the daily quota is gone, so the batch stops instead).
LLM_MAX_RETRIES=5
LLM_MAX_RETRY_WAIT=300

# ─────────────────────────────────────────────────────────────────────────────
#  PostgreSQL — needed by main.py and the Streamlit UI, not by test.py
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=therapy_db
DB_USER=postgres
DB_PASSWORD=password

DEFAULT_PATIENT_ID=1
